{
  "name": "@inpro/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "jest -c jest.config.cjs",
    "test:integration": "jest -c jest.config.cjs --runInBand",
    "test:db-integration": "jest -c jest.config.cjs --runInBand test/app.db.integration.spec.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.14",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.2",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.3.1",
    "jest": "^30.2.0",
    "prisma": "^6.16.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@prisma/client": "^6.16.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
